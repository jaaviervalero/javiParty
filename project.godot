; Engine configuration file.
config_version=5

[application]

config/name="javiParty"
config/description="Party game de minijuegos para Android TV con móviles como mando (DSU)."
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Settings="*res://core/settings.gd"
Sfx="*res://core/sfx.gd"
DSUClient="*res://net/dsu_client.gd"
NetworkScanner="*res://net/network_scanner.gd"
PlayerManager="*res://core/player_manager.gd"
GameFlow="*res://core/game_flow.gd"
DebugOverlay="*res://ui/debug_overlay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.984, 0.988, 0.992, 1)
anti_aliasing/quality/msaa_2d=0
